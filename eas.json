{
  "cli": {
    "version": ">= 27.10.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_PENLIA_UI_DEMO": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_PENLIA_UI_DEMO": "0"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PENLIA_UI_DEMO": "0"
      }
    },
    "ui-demo": {
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PENLIA_UI_DEMO": "1"
      }
    }
  }
}
