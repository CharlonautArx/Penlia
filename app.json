{
  "expo": {
    "name": "朋聊",
    "slug": "penlia",
    "version": "0.1.0",
    "scheme": "penlia",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/penlia_new_icon.jpg",
    "ios": {
      "bundleIdentifier": "app.penlia.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.penlia.mobile",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/penlia_new_icon_adaptive.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/with-penlia-colors",
      [
        "./plugins/with-penlia-launch-screen",
        { "source": "./assets/startup/penlia_new_splash.jpg" }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#FFFFFF",
            "dark": { "backgroundColor": "#FFFFFF" }
          },
          "ios": {
            "image": "./assets/adaptive-icon.png",
            "imageWidth": 160,
            "backgroundColor": "#F8D9E2"
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false }],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.hyphenate.** { *; }\n-dontwarn com.hyphenate.**"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许选择用于头像、聊天、动态、日志和相册的照片。",
          "cameraPermission": "允许朋聊扫描好友或群邀请二维码。",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "在你确认发送位置前，允许朋聊获取一次当前位置。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ]
  }
}
