{
  "expo": {
    "name": "朋聊",
    "slug": "penlia",
    "version": "0.1.0",
    "scheme": "penlia",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FA",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.penlia.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.penlia.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8D9E2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F8D9E2"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.hyphenate.** { *; }\n-dontwarn com.hyphenate.**"
          }
        }
      ]
    ]
  }
}
