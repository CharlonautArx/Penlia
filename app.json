{
  "expo": {
    "name": "朋聊",
    "slug": "penlia",
    "version": "0.1.0",
    "scheme": "penlia",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FA",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.penlia.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.penlia.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8D9E2",
        "backgroundImage": "./assets/identity/icon-background.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F8D9E2"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.hyphenate.** { *; }\n-dontwarn com.hyphenate.**"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许选择用于头像、聊天、动态、日志和相册的照片。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "在你确认发送位置前，允许朋聊获取一次当前位置。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许你在视频通话中开启本机预览。",
          "microphonePermission": "允许你在通话设置中检查麦克风权限。",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ]
    ]
  }
}
